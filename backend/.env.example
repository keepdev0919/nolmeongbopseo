# 백엔드 환경변수 예시. 실제 값은 .env에 채워주세요.
# .env는 프로젝트 루트(졸프/) 또는 backend/ 에 두면 됩니다.

# OpenAI / 외부 API
OPENAI_API_KEY=sk-...
GOOGLE_MAPS_API_KEY=AIza...
KTO_API_KEY=...

# 운영자 알림 (텔레그램) — 없으면 보내지 않음
# 토큰: 텔레그램 @BotFather 에서 /newbot · chat id: 봇에게 말을 건 뒤 getUpdates 응답의 message.chat.id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
